PORT=5001
CLIENT_ORIGINS=http://localhost:5173,https://your-frontend.example.com
MONGODB_CONNECTIONSTRING=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=<app-name>
# Optional: use resolvers that support Atlas SRV/TXT lookups when local DNS refuses them.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
TRANSLATION_AI_URL=http://127.0.0.1:8001
TRANSLATION_AI_KEY=replace_with_a_long_random_translation_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Production email via Brevo HTTP API over HTTPS port 443 (works on Render Free, 300 emails/day):
# BREVO_API_KEY=xkeysib-your_brevo_v3_api_key
EMAIL_USER=your_verified_sender@example.com
# EMAIL_FROM=your_verified_sender@example.com
# EMAIL_SENDER_NAME=Shrimple Support
# EMAIL_TIMEOUT_MS=10000
# Local / SMTP fallback (when BREVO_API_KEY is not set):
EMAIL_SERVICE=gmail
EMAIL_PASS=your_email_app_password
# Optional HTTPS webhook fallback:
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
# EMAIL_WEBHOOK_SECRET=optional_shared_secret
# Use these only with a custom SMTP server:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
